---
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeTags, locales, ogLocales, useTranslations, type Locale } from '../i18n/ui';
import { absoluteUrl, localePath, stripLocale } from '../i18n/urls';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** path inside the locale, without leading slash: '', 'plants/', 'plants/rice-oryza/' */
  path?: string;
  bodyClass?: string;
  /** error pages are not indexable and have no locale alternates */
  noindex?: boolean;
}

const { locale, title, description, path = '', bodyClass = '', noindex = false } = Astro.props;
const t = useTranslations(locale);
const pathname = Astro.url.pathname;
const canonical = noindex ? null : absoluteUrl(locale, path);
// hreflang must be absolute URLs (Lighthouse "hreflang" audit + Google guidance)
const rest = stripLocale(pathname).rest;
const ogImage = null; // no unapproved media is published; og:image intentionally omitted
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {noindex ? null : locales.map((l) => (
      <link rel="alternate" hreflang={localeTags[l]} href={absoluteUrl(l, rest)} />
    ))}
    {canonical ? <link rel="alternate" hreflang="x-default" href={absoluteUrl('th', rest)} /> : null}
    <meta name="theme-color" content="#173d32" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.meta.siteShort} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {ogImage ? <meta property="og:image" content={ogImage} /> : null}
    <meta name="twitter:card" content="summary" />
    <link rel="sitemap" href={localePath('th', 'sitemap.xml')} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <Header locale={locale} pathname={pathname} fallbackToHome={noindex} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      // scroll reveals — subtle, and completely inert under prefers-reduced-motion
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nodes = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        nodes.forEach((n) => n.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        nodes.forEach((n) => io.observe(n));
      }
    </script>
  </body>
</html>
