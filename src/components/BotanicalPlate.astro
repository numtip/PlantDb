---
/**
 * BotanicalPlate — deterministic, dependency-free botanical placeholder artwork.
 *
 * Why inline SVG instead of photos: C5 must not publish unapproved media, and a
 * generated plate can never 404 or shift layout. The real images slot into the same
 * box later (see docs/media contract in C5-REPORT.md).
 */
export interface Props {
  seed: string;
  /** accessible description; pass null for purely decorative plates */
  label?: string | null;
  variant?: 'default' | 'tall' | 'wide';
  tone?: 'sage' | 'bronze' | 'forest';
}

const { seed, label = null, variant = 'default', tone = 'sage' } = Astro.props;

// cheap deterministic hash → stable artwork per record
const hash = Array.from(seed).reduce((acc, ch) => (acc * 31 + ch.charCodeAt(0)) % 100000, 7);
const petals = 5 + (hash % 4);
const rot = hash % 30;
const offset = (hash % 7) - 3;
const spread = 0.62 + ((hash % 5) / 20);

const ink = { sage: '#173d32', bronze: '#9c6a37', forest: '#0f2a22' }[tone];
const fills = { sage: '#b9c99a', bronze: '#e3c19b', forest: '#d8e0c6' }[tone];
---

<div class:list={['plate', variant === 'tall' && 'plate--tall', variant === 'wide' && 'plate--wide']}>
  <svg
    class="plate__art"
    viewBox="0 0 400 300"
    preserveAspectRatio="xMidYMid slice"
    role={label ? 'img' : 'presentation'}
    aria-label={label ?? undefined}
    aria-hidden={label ? undefined : 'true'}
    focusable="false"
  >
    <defs>
      <linearGradient id={`g-${hash}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color={fills} />
        <stop offset="100%" stop-color="#f6f3e9" />
      </linearGradient>
    </defs>
    <rect width="400" height="300" fill={`url(#g-${hash})`} />
    <g transform={`translate(200 170) rotate(${rot})`} opacity="0.9">
      {Array.from({ length: petals }).map((_, i) => {
        const angle = (360 / petals) * i + offset;
        return (
          <ellipse
            cx="0"
            cy="0"
            rx="26"
            ry={78 * spread}
            transform={`rotate(${angle}) translate(0 -46)`}
            fill={ink}
            opacity={0.16 + (i % 3) * 0.07}
          />
        );
      })}
      <circle r="16" fill={ink} opacity="0.5" />
    </g>
    <path
      d="M0 300 C 90 250 130 210 200 210 C 270 210 310 250 400 300 Z"
      fill={ink}
      opacity="0.1"
    />
    <path d="M0 300 C 110 262 150 236 200 236 C 250 236 290 262 400 300 Z" fill={ink} opacity="0.08" />
  </svg>
  <span class="plate__grain" aria-hidden="true"></span>
</div>

<style>
  .plate__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform var(--dur-slow) var(--ease-organic);
  }
  .card:hover .plate__art,
  .plate:hover .plate__art {
    transform: scale(1.035);
  }
  .plate__grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(23, 61, 50, 0.07) 1px, transparent 1px);
    background-size: 6px 6px;
    mix-blend-mode: multiply;
    opacity: 0.5;
    pointer-events: none;
  }
</style>
